{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FerroConfigurator",
  "version": "0.1.0",
  "identifier": "no.ferrowasp.configurator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FerroConfigurator",
        "width": 1100,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
